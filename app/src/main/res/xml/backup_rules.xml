<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for devices with API 30 or lower.
   See https://developer.android.com/guide/topics/data/autobackup
   Android 12+ uses data_extraction_rules.xml instead; keep both files in sync.
-->
<full-backup-content>
    <!-- Session encrypted with a device-bound Keystore key: useless on another device. -->
    <exclude domain="sharedpref" path="incleanhome_secure_session.xml" />
    <!-- Experiment variants, pending tracking events and reminders (US42/US43): device data only. -->
    <exclude domain="sharedpref" path="incleanhome_experiments.xml" />
    <!-- Tracking exports written by the staging diagnostics screen. -->
    <exclude domain="external" path="." />
</full-backup-content>
